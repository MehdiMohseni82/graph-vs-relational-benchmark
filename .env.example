# Equal memory for both engines. The values used for the published 100M and 500M results:
#   MySQL:       40g container, 32G InnoDB buffer pool
#   NebulaGraph: 32g storaged (with a 24 GB RocksDB block cache) + 8g graphd = 40g
MYSQL_MEM_LIMIT=40g
MYSQL_BUFFER_POOL=32G
NEBULA_STORAGE_MEM_LIMIT=32g
NEBULA_BLOCK_CACHE_MB=24576
NEBULA_GRAPH_MEM_LIMIT=8g
